# Variáveis do ambiente LOCAL. O `npm run setup` copia este arquivo para .env.local.
# Só valores de TESTE: nada daqui serve em staging ou produção (AGENTS R7).

# Chaves de criptografia de TESTE (ADR 0003): base64 de 32 bytes. Ficam vazias aqui de
# propósito; `npm run setup` (ou `npm run gen-test-keys`) gera valores aleatórios no seu
# .env.local. Produção usa chaves próprias, guardadas só no servidor.
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
# Rotação (src/server/crypto, #45): versão da chave atual (prefixo v<n> do valor cifrado) e
# chaves antigas que só decifram até tudo ser recifrado. Localmente, não precisa mexer.
# FIELD_ENCRYPTION_KEY_VERSION=1
# FIELD_ENCRYPTION_PREVIOUS_KEYS=v1:<base64 de 32 bytes>

# URL que o /api/healthz consulta para saber se o banco está de pé (src/server/env.ts):
# o /ready do PostgREST do Supabase local. Opcional em desenvolvimento.
DB_HEALTH_URL=http://127.0.0.1:54321/rest-admin/v1/ready

# Questionário das casas (ADR 0008 §2.1, #91). Vazio = usa o exemplo fictício de
# config/questionnaire.example.json. Em produção, aponta para o arquivo real instalado só no
# servidor (ex.: data/config/questionnaire.json), que nunca entra no repositório.
QUESTIONNAIRE_PATH=

# Login (#9): o Supabase local (`npm run db:start`). A chave anon aparece em
# `npx supabase status` (ANON_KEY ou PUBLISHABLE_KEY); nunca use a service_role (R6).
# SITE_URL é o endereço do `npm run dev`. Os e-mails do link mágico caem no Mailpit local
# (endereço em `npx supabase status`).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SITE_URL=http://127.0.0.1:3000
