# Modelo de variáveis. NENHUM valor real aqui — nem de exemplo com cara de
# chave: valor de alta entropia neste arquivo faz os scanners de segredo
# (gitleaks, GitGuardian) acusarem vazamento, e silenciar o scanner seria a
# correção errada. O formato esperado está no comentário de cada bloco.
#
# Os valores reais são gerados pelo gen-secrets.sh no próprio servidor,
# gravados com modo 0600, e nunca entram neste repositório (R7).
# Cada ambiente tem o seu arquivo e as suas chaves (ADR 0009 §2).

# ─── identidade do ambiente (staging e produção dividem o mesmo host) ───
# Sem isso os dois ambientes dividiriam containers, volumes e o nome na rede
# do proxy — ver a seção "Armadilhas" em docs/OPERACAO.md.
COMPOSE_PROJECT_NAME=nome-do-ambiente
KONG_ALIAS=nome-do-ambiente-kong
# Alias do APP na rede do proxy, e a rede interna do Supabase deste ambiente.
# O `docker-compose.app.yml` exige as duas com `:?obrigatorio`. Faltando, o
# deploy só falha no `up` -- DEPOIS de as migrations já terem rodado, que é o
# pior ponto para quebrar: o banco avança e o app não. (Medido em 2026-11-27,
# instalando o staging: as duas não existiam no `secrets/env`.)
#
# A rede interna chama-se <COMPOSE_PROJECT_NAME>_interna, criada pelo compose
# do Supabase deste mesmo ambiente. Confira com `docker network ls`.
APP_ALIAS=nome-do-ambiente-app
SUPABASE_NETWORK=nome-do-ambiente_interna

# ─── banco: uma senha por papel (issue #95) ───
# 40 caracteres alfanuméricos cada, sem símbolo (todas entram em URI de
# conexão) e OBRIGATORIAMENTE diferentes entre si. Quem recebe cada uma:
#   POSTGRES_PASSWORD      — supabase_admin (superusuário). Só o container do
#                            banco e o job de migrations (#81). NUNCA o rest
#                            nem o auth.
#   AUTHENTICATOR_PASSWORD — papel `authenticator`, só o PostgREST (rest).
#   AUTH_ADMIN_PASSWORD    — papel `supabase_auth_admin`, só o GoTrue (auth).
POSTGRES_PASSWORD=gerado-por-gen-secrets
AUTHENTICATOR_PASSWORD=gerado-por-gen-secrets
AUTH_ADMIN_PASSWORD=gerado-por-gen-secrets

# ─── JWT (compartilhado por GoTrue e PostgREST) ───
# JWT_SECRET: 64 caracteres alfanuméricos.
# ANON_KEY e SERVICE_ROLE_KEY: JWT HS256 assinados com o JWT_SECRET,
# com `role` igual a "anon" e "service_role".
JWT_SECRET=gerado-por-gen-secrets
ANON_KEY=gerado-por-gen-secrets
SERVICE_ROLE_KEY=gerado-por-gen-secrets

# ─── endereços por ambiente ───
SITE_URL=https://exemplo.invalid
# Onde o GoTrue busca os templates de e-mail (rede interna, alias do app). Opcional: sem ele vale http://app:3000.
# APP_INTERNAL_URL=http://app:3000
# Login com Google. Vêm do Google Cloud (cliente OAuth tipo "Web application").
# Com GOOGLE_ENABLED=true e credencial vazia, o auth NÃO SOBE.
# O redirect a cadastrar no Google é <SITE_URL>/auth/v1/callback, sem barra final.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
URI_ALLOW_LIST=https://exemplo.invalid

# ─── ADR 0003: cifra de dado pessoal ───
# 32 bytes aleatórios em base64 cada, e OBRIGATORIAMENTE diferentes entre si.
# Perder FIELD_ENCRYPTION_KEY torna ilegível todo dado já cifrado.
FIELD_ENCRYPTION_KEY=gerado-por-gen-secrets
BLIND_INDEX_KEY=gerado-por-gen-secrets
# ADR 0014: assina o resultado do questionário. O MESMO valor precisa estar no banco
# (app.server_secrets; docs/OPERACAO.md, "Questionário das casas").
QUESTIONNAIRE_SIGNING_KEY=gerado-por-gen-secrets

# ─── Cloudflare Turnstile no pedido do link por e-mail (#116) ───
# Criadas no painel da Cloudflare (Turnstile → widget do ambiente), NÃO pelo
# gen-secrets.sh, que deixa as duas vazias. O app não sobe em produção sem
# elas. A site key é pública (vai para a tela); a secret fica só no servidor.
# Formato: "0x" seguido de letras, números, "_" ou "-".
TURNSTILE_SITE_KEY=criada-no-painel-da-cloudflare
TURNSTILE_SECRET_KEY=criada-no-painel-da-cloudflare

# ─── e-mail: a porta 25 é bloqueada, então só por relay externo ───
# Deixe vazio enquanto o cadastro estiver fechado (#87, #26).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
